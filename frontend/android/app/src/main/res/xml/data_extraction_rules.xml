<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión de Supabase vive en el almacenamiento del WebView: no se respalda en la nube
     ni se copia a otro teléfono. Tras reinstalar o cambiar de equipo se inicia sesión de nuevo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
