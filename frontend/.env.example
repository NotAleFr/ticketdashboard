# ==========================================
# Configuración del Frontend (Vite)
# ==========================================

# URL base del Backend FastAPI
# Local development uses Vite's same-origin proxy to http://127.0.0.1:8000.
VITE_API_URL=/api

# Conexión directa a Supabase
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# These values are visible in the browser. Do not add SUPABASE_JWT_SECRET,
# SUPABASE_SERVICE_ROLE_KEY, or DATABASE_URL to this file.
