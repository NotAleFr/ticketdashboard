# Configuración del frontend (Vite). Copiar a .env y completar.

# En desarrollo, /api pasa por el proxy de Vite a http://127.0.0.1:8000.
# Para un build desplegado, usar la URL completa del backend.
VITE_API_URL=/api

# Supabase Dashboard > Project Settings > API Keys
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-o-publishable-key
