# Configuración del backend (FastAPI + Supabase). Copiar a .env y completar.

# Supabase Dashboard > Connect > Connection string (URI)
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Dashboard > Project Settings > API Keys
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=tu-publishable-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Solo si el proyecto firma tokens con HS256 (JWT Settings > Legacy JWT Secret).
SUPABASE_JWT_SECRET=

# Página a la que lleva el correo de recuperación. Debe coincidir con el puerto
# del frontend y estar en Authentication > URL Configuration > Redirect URLs.
PASSWORD_RECOVERY_REDIRECT_URL=http://127.0.0.1:5173/src/pages/login/nueva-contrasena.html

# Orígenes permitidos (arreglo JSON). https://localhost es la app Android.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://localhost"]
