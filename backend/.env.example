# ==========================================
# Configuración del Backend (FastAPI + Supabase)
# ==========================================

# 1. Base de Datos (PostgreSQL en Supabase)
# Se obtiene en: Supabase Dashboard > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# 2. Supabase Auth y API
# Se obtiene en: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui

# 3. JWT Secret para validación de tokens en FastAPI (API-42)
# Se obtiene en: Supabase Dashboard > Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=tu-jwt-secret-aqui

# 4. Configuración del Servidor
PORT=8000
HOST=127.0.0.1
DEBUG=True
