# ==========================================
# Configuración del Backend (FastAPI + Supabase)
# ==========================================

# 1. Base de Datos (PostgreSQL en Supabase)
# Se obtiene en: Supabase Dashboard > Connect > Connection string (URI).
# URL-encode reserved password characters (for example, @ becomes %40).
# If the direct db host is IPv6-only on your network, use Supabase's Session
# Pooler URI instead. Keep the postgresql+psycopg2 scheme and URL-encode the password.
DATABASE_URL=postgresql+psycopg2://postgres:[URL-ENCODED-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# 2. Supabase Auth y API
# Se obtiene en: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui

# 3. Compatibilidad opcional con JWTs HS256 heredados
# Los JWTs ES256 actuales se validan con el JWKS público de SUPABASE_URL.
# Solo configura esta variable si el proyecto todavía emite HS256.
# SUPABASE_JWT_SECRET=tu-jwt-secret-aqui

# 4. Configuración del Servidor
PORT=8000
HOST=127.0.0.1
DEBUG=True
